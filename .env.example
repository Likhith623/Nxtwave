# ==============================================================================
# PROJECT COMPASS: ENVIRONMENT CONFIGURATION
# NxtWave Growth Intern Challenge | 48-Hour Build | ₹0 Development Cost
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (SQLite default for local zero-cost execution)
DATABASE_URL=sqlite:///./local_compass.db

# Admin Security Token (used to access /admin metrics and data reset)
ADMIN_TOKEN=compass_growth_admin_secret_2026

# Workshop Registration Destination
# Leave empty to use local simulated demo registration mode
# Set to official NxtWave workshop link for live campaign mode:
# WORKSHOP_REGISTRATION_URL=https://nxtwave.in/workshops/build-ai-project-60-mins
WORKSHOP_REGISTRATION_URL=

# Optional AI Integration (Disabled by default - zero cost rules engine is primary)
ENABLE_OPTIONAL_LLM=False
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional WhatsApp Cloud API Integration (Dry-run by default)
WHATSAPP_DRY_RUN=True
WHATSAPP_VERIFY_TOKEN=compass_whatsapp_webhook_token_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
